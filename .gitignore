# 开发临时文件
# ========================================

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# 测试临时产物（保留正式源码）
skills/*/scripts/*.json
skills/*/scripts/*_test.json
skills/*/scripts/*_qa*
skills/*/scripts/smoke_*
skills/*/scripts/fail_*
skills/*/scripts/edge_*
skills/*/scripts/mock_*
skills/*/scripts/e2e_*

# zip 分发包（源码已上传，zip 不进 git）
skills/*.zip
skills/dist/

